{
  "manifest_version": 3,
  "name": "Workspace Manager",
  "version": "0.5.0",
  "description": "Unified multi-tab workspace manager for browser-based AI chats (ChatGPT, Claude, Gemini, etc.).",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Workspace Manager",
    "default_icon": "icons/icon.svg"
  },
  "side_panel": {
    "default_path": "ui/manager.html?mode=panel"
  },
  "sidebar_action": {
    "default_title": "Workspace Manager",
    "default_panel": "ui/manager.html?mode=panel",
    "default_icon": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
