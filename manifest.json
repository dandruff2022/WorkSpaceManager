{
  "manifest_version": 3,
  "name": "Workspace Manager",
  "version": "0.6.0",
  "description": "Use your saved prompts on any AI chat site, send one prompt to several chatbots at once, and get notified when answers are ready.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "sidePanel",
    "unlimitedStorage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "utils/site_profiles_registry.js",
      "utils/skills_registry.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Workspace Manager",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "ui/manager.html?mode=panel"
  },
  "sidebar_action": {
    "default_title": "Workspace Manager",
    "default_panel": "ui/manager.html?mode=panel",
    "default_icon": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge.js",
        "utils/styles_registry.js",
        "utils/library.js",
        "utils/picker_core.js",
        "utils/autocomplete.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "main_world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
